<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+ backup rules. Nothing is backed up to the cloud: the learned word history is
   typing data and settings are trivial to redo. allowBackup="false" in the manifest covers
   older releases. Direct device-to-device transfer (to the user's own new phone) is allowed.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
</data-extraction-rules>
